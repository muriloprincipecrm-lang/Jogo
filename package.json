{
  "name": "jogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n NEXT,SOCKET \"next dev --hostname 0.0.0.0\" \"node server/socket-server.mjs\"",
    "build": "next build",
    "start": "concurrently -k -n NEXT,SOCKET \"next start --hostname 0.0.0.0\" \"node server/socket-server.mjs\"",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
